# Python bytecode
__pycache__/
*.py[cod]
*$py.class

# Jupyter checkpoints
.ipynb_checkpoints

# Virtual environments
.env
.venv
env/
venv/
ENV/

# IDE settings
.vscode/
.idea/
*.swp
*.swo
*~

